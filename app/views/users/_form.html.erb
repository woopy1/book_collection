<%= form_with model: user do |form| %>
  <% if user.errors.any? %>
    <ul>
      <% user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <div>
    <%= form.label :username %>
    <%= form.text_field :username, required: true %>
  </div>
  <div><%= form.submit %></div>
<% end %>