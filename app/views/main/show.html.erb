<h1><%= @book.name %></h1>

<p><strong>Description:</strong> <%= @book.description.presence || "None" %></p>
<p><strong>Position:</strong> <%= @book.position || "None" %></p>
<p><strong>Completed:</strong> <%= @book.completed ? "Yes" : "No" %></p>
<p><strong>Created:</strong> <%= @book.created_at %></p>
<p><strong>Updated:</strong> <%= @book.updated_at %></p>

<%= link_to "Edit", edit_book_path(@book) %>
<br />
<%= link_to "Back to books", main_index_path %>
