<h1>Book Collection</h1>
<p>Welcome to the Book Collection App!</p>

<% if flash[:notice] %>
	<script>
		alert(<%= raw flash[:notice].to_json %>);
	</script>
<% end %>

<%= link_to "Add a book", new_book_path %>

<h2> Collection of Books</h2>

<ul>
	<% @books.each do |book| %>
		<li>
			<%= link_to book.title, book_path(book) %>
			<%= link_to "Edit", edit_book_path(book) %>
			<%= button_to "Delete", book_path(book), method: :delete,
				data: { turbo_confirm: "Delete #{book.title}?" } %>
		</li>
	<% end %>
</ul>


<p style="color: green"><%= notice %></p> 

 

<h1>Books</h1> 

<h1>This is the authenticated version 2</h1> 

 

<h1>You're logged in! Welcome to the Dashboard!</h1> 

<%= link_to "Sign Out", destroy_admin_session_path %> 

 

<div id="books"> 

  <% @books.each do |book| %> 

    <%= render book %> 

    <p> 

      <%= link_to "Show this book", book %> 

    </p> 

  <% end %> 

</div> 

 

<%= link_to "New book", new_book_path %> 