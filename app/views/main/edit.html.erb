<h1>Edit Book</h1>

<%= form_with model: @book, url: book_path(@book), method: :patch, local: true do |form| %>
  <p>
    <%= form.label :title, "Title" %><br>
    <%= form.text_field :title, required: true %>
  </p>

  <p>
    <%= form.label :author %><br>
    <%= form.text_field :author %>
  </p>

  <p>
    <%= form.label :price %><br>
    <%= form.number_field :price, step: 0.01 %>
  </p>

  <p>
    <%= form.label :published_date %><br>
    <%= form.date_select :published_date, prompt: true %>
  </p>

  <p>
    <%= form.label :description %><br>
    <%= form.text_area :description %>
  </p>

  <p>
    <%= form.label :position %><br>
    <%= form.number_field :position %>
  </p>

  <p>
    <%= form.label :completed %>
    <%= form.check_box :completed %>
  </p>

  <%= form.submit "Save changes" %>
<% end %>

<%= link_to "Back to book", book_path(@book) %>
<br />
<%= link_to "Back to main page", main_index_path %>
