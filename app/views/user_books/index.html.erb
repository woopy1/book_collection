<h1>User Books</h1>

<% if notice %><p><%= notice %></p><% end %>

<table>
  <thead>
    <tr><th>Username</th><th>Book Title</th><th colspan="3"></th></tr>
  </thead>
  <tbody>
    <% @user_books.each do |user_book| %>
      <tr>
        <td><%= user_book.user.username %></td>
        <td><%= user_book.book.title %></td>
        <td><%= link_to "Show", user_book %></td>
        <td><%= link_to "Edit", edit_user_book_path(user_book) %></td>
        <td><%= button_to "Destroy", user_book, method: :delete, data: { turbo_confirm: "Remove this book from the user?" } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<p><%= link_to "New User Book", new_user_book_path %></p>
<p><%= link_to "Book Index", books_path %></p>
<p><%= link_to "User Index", users_path %></p>